# LibreTranslate on top-voice-1: settings, in deploy/hetzner/.env on the server.
# bootstrap.sh writes the first .env from this file and later adds any setting
# that appears here and is missing there; a value already in .env always wins.
# After changing .env, run the deploy again (same commit): it applies it.

# The languages to serve: exactly the 50 the old instance listed at /languages.
# They also decide what /detect can answer, so changing this list changes
# answers for every caller.
LT_LOAD_ONLY=en,sq,ar,az,eu,bn,bg,ca,zh-Hans,zh-Hant,cs,da,nl,eo,et,fi,fr,gl,de,el,he,hi,hu,id,ga,it,ja,ko,ky,lv,lt,ms,nb,fa,pl,pt,pt-BR,ro,ru,sk,sl,es,sw,sv,tl,th,tr,uk,ur,vi

# Same as the old instance: no API key needed (one sent is ignored), no limits.
LT_API_KEYS=false
LT_CHAR_LIMIT=-1
LT_REQ_LIMIT=-1

# Resources on a server shared with Top Voice and FOMO Maldives.
LT_MEMORY=4g
LT_CPUS=3
LT_THREADS=4

# deploy.sh keeps the running image's tag here (the commit, 12 characters).
# APP_IMAGE_TAG=
